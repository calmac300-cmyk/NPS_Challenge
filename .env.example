# Copy this file to .env and fill in your Firebase project credentials.
# Get these from: Firebase Console → Project Settings → Your Apps → Web App → SDK setup
#
# Setup steps:
#   1. Go to https://console.firebase.google.com/
#   2. Create a new project (or use an existing one)
#   3. Add a Web App
#   4. Enable Firestore Database (Start in test mode for now)
#   5. Copy the config values below
#   6. Open the app — it will auto-seed all 391 sites on first load

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: NPS park geocoding — free key at https://www.nps.gov/subjects/developer/get-started.htm
# When set, the Campaign Map shows individual site dots for visited parks.
VITE_NPS_API_KEY= 0jWSWXCDBTfgSon7lWkiDsbZSGyt4h19wLd5eOqc
